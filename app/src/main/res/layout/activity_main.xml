<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_titre_nj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Formulaire d'Enregistrement"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_nom_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur" />

    <EditText
        android:id="@+id/et_annee_naissance_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de naissance (ex: 1990)"
        android:inputType="number" />

    <EditText
        android:id="@+id/et_annee_dest_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de destination (ex: 2050)"
        android:inputType="number" />

    <Spinner
        android:id="@+id/sp_motif_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_inspecter_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inspecter le profil" />

</LinearLayout>